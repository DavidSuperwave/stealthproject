# ============================================================
# Doble Labs - Environment Variables
# Copy to .env.local for local development.
# Configure the same names in Vercel Production for app.doblelabs.com.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App URL
NEXT_PUBLIC_APP_URL=https://app.doblelabs.com

# Stripe
# Use sk_test_ / pk_test_ locally and sk_live_ / pk_live_ in Vercel Production.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
# Webhook endpoint: https://app.doblelabs.com/api/stripe/webhook
# Events: checkout.session.completed, invoice.payment_succeeded, invoice.payment_failed,
# customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# LipDub API
LIPDUB_API_KEY=your-lipdub-api-key
LIPDUB_API_URL=https://api.lipdub.ai/v1

# OpenRouter script chat
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_SCRIPT_MODEL=moonshotai/kimi-k2.6

# Vercel Cron
# Cron path: /api/cron/poll-generation
# Header: Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=your-cron-secret

# App notification email via Resend
# Supabase Auth SMTP is configured in Supabase and does not replace this app sender.
RESEND_API_KEY=re_your-resend-key
EMAIL_FROM=DobleLabs <noreply@doblelabs.com>

# Close CRM
CLOSE_API_KEY=api_your-close-api-key
CLOSE_EMAIL_SEQUENCE_ID=seq_your-close-sequence-id

# Admin access
ADMIN_USER_ID=your-supabase-user-uuid
NEXT_PUBLIC_ADMIN_USER_ID=your-supabase-user-uuid
